REACT_APP_FIREBASE_APP_CHECK_SITE_KEY=your-recaptcha-v3-site-key
# Local development only: set true to print a debug token in the browser console.
# Register that token in Firebase Console > App Check > Apps. Never enable in production.
REACT_APP_APPCHECK_DEBUG=false

# Backend API base URL. Never put payment-provider secret keys in this file.
REACT_APP_API_BASE_URL=http://localhost:4000/api

# Display-only estimate for USD to ARS. The backend/provider calculates the charge.
REACT_APP_USD_ARS_ESTIMATE_RATE=1000
